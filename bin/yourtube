#!/bin/zsh
set -euo pipefail

project_dir="$(cd "$(dirname "$0")/.." && pwd)"
cd "$project_dir"

.venv/bin/python manage.py migrate --noinput
.venv/bin/python manage.py collectstatic --noinput
.venv/bin/python manage.py sync_library

port="${YOURTUBE_PORT:-8081}"

lan_ip="$(/usr/sbin/ipconfig getifaddr en0 2>/dev/null || /usr/sbin/ipconfig getifaddr en1 2>/dev/null || true)"
echo "YourTube is available at http://127.0.0.1:$port/"
if [[ -n "$lan_ip" ]]; then
  echo "On your LAN: http://$lan_ip:$port/"
fi

(sleep 1 && open "http://127.0.0.1:$port/") >/dev/null 2>&1 &
exec .venv/bin/python -m gunicorn yourtube.wsgi:application --workers 1 --bind "0.0.0.0:$port" --timeout 3600
